<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="DEBUG">
    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
        <RollingFile name="file" fileName="d:/app/application/tomcat/mes/logs/mes12.log"
                     filePattern="d:/app/application/tomcat/mes/logs/$${date:yyyy-MM}/mes12-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout>
                <Pattern>%d %p %c{1.} [%t] %m%n</Pattern>
            </PatternLayout>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="25 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="500" fileIndex="min"/>
        </RollingFile>

    </Appenders>
    <Loggers>
        <Logger name="project" level="debug" additivity="false">
            <!--            <appender-ref ref="console" />-->
            <appender-ref ref="file" />
        </Logger>
        <Logger name="jdbc.sqlonly" level="info" additivity="false">
            <appender-ref ref="console" />
            <appender-ref ref="file" />
            <RegexFilter regex="(?s).*==IGNORE_LOG==.*" onMatch="DENY" onMismatch="NEUTRAL" useRawMsg="true" />
        </Logger>
        <Logger name="org.springframework" level="info" additivity="false">
            <appender-ref ref="console" />
        </Logger>
        <Logger name="project.common.aop.PerformanceTraceAdvice" level="error">
            <appender-ref ref="console" />
        </Logger>
        <Root level="error">
            <AppenderRef ref="console" />
        </Root>

    </Loggers>
</Configuration>