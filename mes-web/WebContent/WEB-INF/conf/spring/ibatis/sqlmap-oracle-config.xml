<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE sqlMapConfig
    PUBLIC "-//ibatis.apache.org//DTD SQL Map Config 2.0//EN"
    "http://ibatis.apache.org/dtd/sql-map-config-2.dtd">
<sqlMapConfig>
	<settings useStatementNamespaces="true"/>	
	
	<typeHandler javaType="java.lang.String" callback="org.springframework.orm.ibatis.support.ClobStringTypeHandler" jdbcType="CLOB"/>
	
	
	<!-- 일반/시스템/공통 -->
	<sqlMap resource="com/common/dao/sqlmap/Common_oracle.xml"/>
	<sqlMap resource="com/common/dao/sqlmap/System_oracle.xml"/>
	<sqlMap resource="com/wms/dao/sqlmap/Wms_oracle.xml"/>
	
	
	<!-- WMS 비니지스 프로세스 : 마스터관리 -->
	<sqlMap resource="com/wms/dao/sqlmap/Admin_oracle.xml"/>
	
	
	<!-- WMS 비니지스 프로세스 : 오더관리 -->
	<sqlMap resource="com/wms/dao/sqlmap/Order_oracle.xml"/>
	
	
	<!-- WMS 비니지스 프로세스 : 입고관리 -->
	<sqlMap resource="com/wms/dao/sqlmap/Inbound_oracle.xml"/>
	
	
	<!-- WMS 비니지스 프로세스 : 출더관리 -->
	<sqlMap resource="com/wms/dao/sqlmap/Outbound_oracle.xml"/>
	
	
	<!-- WMS 비니지스 프로세스 : 재고관리 -->
	<sqlMap resource="com/wms/dao/sqlmap/Inventory_oracle.xml"/>
	
	
	<!-- WMS 비니지스 프로세스 : 작업오더관리 -->
	<sqlMap resource="com/wms/dao/sqlmap/Task_oracle.xml"/>
	
	<!-- 인터페이스 -->
	<sqlMap resource="com/wms/dao/sqlmap/Erpif_oracle.xml"/>
	
	
	<!-- 레포트 및 출력물 -->
	<sqlMap resource="com/wms/dao/sqlmap/Report_oracle.xml"/>
	<sqlMap resource="com/wms/dao/sqlmap/Label_oracle.xml"/>
	
	
	<!-- PDA 및 모바일 -->
	<sqlMap resource="com/wms/dao/sqlmap/WmsPda_oracle.xml"/>
	<sqlMap resource="com/mobile/dao/sqlmap/Mobile_oracle.xml"/>
	
	<sqlMap resource="com/mobile/dao/sqlmap/MobileInboundGoodsReceipt_oracle.xml"/>
	<sqlMap resource="com/mobile/dao/sqlmap/MobileInventoryDisplay_oracle.xml"/>
	<sqlMap resource="com/mobile/dao/sqlmap/MobileInventoryPhysicalCount_oracle.xml"/>
	<sqlMap resource="com/mobile/dao/sqlmap/MobilePutaway_oracle.xml"/>
	<sqlMap resource="com/mobile/dao/sqlmap/MobileOutboundPicking_oracle.xml"/>
	
	
	
	<!-- 미확인 DAO -->
	<sqlMap resource="com/board/dao/sqlmap/Board_oracle.xml"/>
	<sqlMap resource="com/demo/dao/sqlmap/Demo_oracle.xml"/>
	<sqlMap resource="com/aprove/dao/sqlmap/Aprove_oracle.xml"/>
</sqlMapConfig>